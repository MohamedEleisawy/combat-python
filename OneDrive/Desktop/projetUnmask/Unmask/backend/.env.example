# ============================================================
# Unmask Backend — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos clés
# ============================================================

# --- Pilier 3 : Analyse du discours (Claude API) ---
# Obtenez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Pilier 4 : Cohérence d'engagement (YouTube Data API v3) ---
# Créez une clé sur https://console.cloud.google.com (activer YouTube Data API v3)
YOUTUBE_API_KEY=

# --- Pilier 5 : Réputation externe OSINT ---
# Option A : Google Custom Search API (https://programmablesearchengine.google.com)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Option B : Serper.dev (alternative plus simple, 2500 req/mois gratuits)
SERPER_API_KEY=
